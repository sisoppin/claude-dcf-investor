# =====================================================================
# AI Agent Configuration
# Copy this file to `.env` and fill in your values.
# =====================================================================

# ---- Mode -----------------------------------------------------------
# online  -> use Perplexity API
# offline -> use local Ollama
AGENT_MODE=online

# ---- Perplexity (online) --------------------------------------------
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ---- Ollama (offline) -----------------------------------------------
# Use the OpenAI-compatible endpoint (note the /v1 suffix)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Placeholder, Ollama ignores it but the OpenAI SDK requires a value
OLLAMA_API_KEY=ollama

# ---- Agent loop -----------------------------------------------------
MAX_ITERATIONS=10
TEMPERATURE=0.3
VERBOSE=true

# Optional: path to a custom system prompt (.txt or .md). Leave blank for default.
SYSTEM_PROMPT_PATH=

# ---- MCP ------------------------------------------------------------
MCP_CONFIG_PATH=./config/mcp_servers.json

# ---- Search MCP -----------------------------------------------------
# duckduckgo (no key needed) | tavily (better quality, key required)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ---- File Editor MCP ------------------------------------------------
# All file operations are sandboxed to this directory for safety.
WORKSPACE_PATH=./workspace
